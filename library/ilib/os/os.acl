# AC OS Library — lowering rules (ilib:os)
# All calls use os.* dot notation → mapped via Python/JS os object.

os:bash         -> os.bash
os:wait         -> os.wait
os:sbash        -> os.sbash
os:app_open     -> os.app_open
os:mkfile       -> os.mkfile
os:rmfile       -> os.rmfile
os:mkdir        -> os.mkdir
os:rmdir        -> os.rmdir
os:exists       -> os.exists
os:cwd          -> os.cwd
os:env          -> os.env
os:write_to     -> os.write_to
os:append_to    -> os.append_to
os:read         -> os.read
os:pid          -> os.pid

# files, directories, temp paths
os:isdir      -> os.isdir
os:isfile     -> os.isfile
os:size       -> os.size
os:mtime      -> os.mtime
os:copy       -> os.copy
os:move       -> os.move
os:listdir    -> os.listdir
os:tmpdir     -> os.tmpdir
os:tmpfile    -> os.tmpfile
os:mktmpdir   -> os.mktmpdir
os:chdir      -> os.chdir
os:join       -> os.join
os:basename   -> os.basename
os:dirname    -> os.dirname
os:homedir    -> os.homedir
