AC LIB

use ilib dns

Make start func(address, port)
    return dns.start(address, port)

Make url func(hostname, display)
    return dns.url(hostname, display)

Make backend func(hostname, address)
    return dns.backend(hostname, address)

Make resolve func(hostname)
    return dns.resolve(hostname)

Make remove func(hostname)
    return dns.remove(hostname)

Make list func()
    return dns.list()

Make stop func()
    return dns.stop()
