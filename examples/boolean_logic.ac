AC->BNY

<mainloop>
    Term.display $--- AND ---$
    Term.display 0 and 0
    Term.display 0 and 1
    Term.display 1 and 0
    Term.display 1 and 1
    Term.display $--- OR ---$
    Term.display 0 or 0
    Term.display 0 or 1
    Term.display 1 or 0
    Term.display 1 or 1
    Term.display $--- XOR ---$
    Term.display 0 xor 0
    Term.display 0 xor 1
    Term.display 1 xor 0
    Term.display 1 xor 1
    Term.display $--- XNOR ---$
    Term.display not (0 xor 0)
    Term.display not (0 xor 1)
    Term.display not (1 xor 0)
    Term.display not (1 xor 1)
    Term.display $--- NOT ---$
    Term.display not 0
    Term.display not 1
    /kill
<mainloop>
