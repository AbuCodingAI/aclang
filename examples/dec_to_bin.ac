AC->PY

/* Decimal to binary as a string */

use ilib math

Make to_bin func(n)
    IF n is 0
        return $0$
    bits = $$
    WHILST n > 0
        to_string d = math.mod(n, 2)
        bits = d + bits
        n = n // 2
    return bits

<mainloop>
    Term.display to_bin(10)
    Term.display to_bin(255)
    Term.display to_bin(0)
<mainloop>
