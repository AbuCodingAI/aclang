AC->BNY

/* Mini gradebook: average and pass/fail */

Make grade func(score)
    IF score #< 50
        return 1
    return 0

<mainloop>
    scores = [72, 45, 88, 91, 33]
    passed = 0
    s = 0
    FOR v in scores
        free s += v
        IF grade(v) is 1
            free passed += 1
    Term.display s / length scores
    Term.display passed
<mainloop>
