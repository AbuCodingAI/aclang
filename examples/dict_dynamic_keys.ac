AC->PY

/* dict with runtime-built keys: string-concatenated key names inserted in a
   loop, then read back by rebuilding the same keys a second time. */

<mainloop>
    header.display $Dict with dynamic keys$
    d = { seed: 0 }
    i = 0
    WHILST i < 20
        key = $item$ + to_string(i)
        d[key] = i * i
        i = i + 1

    j = 0
    total = 0
    WHILST j < 20
        key = $item$ + to_string(j)
        total = total + d[key]
        j = j + 1

    Term.display total
<mainloop>
