AC->PY

/* Happy number: repeated digit-square-sum reaches 1 */

use ilib math

Make step func(n)
    s = 0
    WHILST n > 0
        d = math.mod(n, 10)
        s += d @ d
        n = n // 10
    return s

Make is_happy func(n)
    i = 0
    WHILST i < 50
        n = step(n)
        IF n is 1
            return 1
        i += 1
    return 0

<mainloop>
    Term.display is_happy(19)
    Term.display is_happy(4)
<mainloop>
